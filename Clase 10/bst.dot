digraph BST {
    node [shape=circle, style=filled, fillcolor=white, fontname="Helvetica"];
    edge [arrowsize=0.7];
    graph [nodesep=0.6, ranksep=0.7];
    50 [ordering="out"];
    50 -> 30;
    50 -> 70;
    {rank=same; 30; 70;}
    30 [ordering="out"];
    30 -> 20;
    30 -> 40;
    {rank=same; 20; 40;}
    20 [ordering="out"];
    40 [ordering="out"];
    70 [ordering="out"];
    70 -> 60;
    70 -> 85;
    {rank=same; 60; 85;}
    60 [ordering="out"];
    inv_izq_60 [style=invis,width=0.1,label=""];
    60 -> inv_izq_60 [style=invis];
    60 -> 65;
    {rank=same; inv_izq_60; 65;}
    65 [ordering="out"];
    inv_izq_65 [style=invis,width=0.1,label=""];
    65 -> inv_izq_65 [style=invis];
    65 -> 66;
    {rank=same; inv_izq_65; 66;}
    66 [ordering="out"];
    85 [ordering="out"];
    85 -> 80;
    inv_der_85 [style=invis,width=0.1,label=""];
    85 -> inv_der_85 [style=invis];
    {rank=same; 80; inv_der_85;}
    80 [ordering="out"];
}
